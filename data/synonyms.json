  "search_rules": {
    "normalization": [
      "忽略全形／半形空白差異。",
      "日文平假名可與對應片假名互相匹配。",
      "中文繁簡差異應盡可能以 synonym dictionary 處理。",
      "搜尋不應要求使用者輸入正式日文名稱。",
      "英文常見名稱可作輔助搜尋詞，但資料顯示以日文正式名稱為主。"
    ],
    "compound_query": [
      "多個詞以空白分隔時，預設採 AND。",
      "例如「京都 兔」代表同時符合京都及兔。",
      "「500円以下」應解析為價格上限，而不是普通文字。",
      "「現在確認」應映射至 current_confirmed。",
      "未能可靠解析的詞仍應作一般全文搜尋。"
    ],
    "price_patterns": [
      "(?:¥|￥|JPY)?\\s*(\\d[\\d,]*)\\s*円?\\s*(?:以下|以内|まで)",
      "(\\d[\\d,]*)\\s*円\\s*(?:以下|以内|まで)",
      "(?:under|below|less than)\\s*¥?\\s*(\\d[\\d,]*)"
    ]
  }
}